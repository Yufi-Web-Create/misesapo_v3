# =========================================
# ミセサポAI Version 3 環境変数テンプレート
# .env.local にコピーして使用する（.env.local はGit管理対象外）
# NEXT_PUBLIC_ を付けた変数はブラウザに公開される
# 資格情報を一切設定しなくても AI_PROVIDER=mock / PAYMENTS_PROVIDER=mock で主要フローが動く
# =========================================

# --- Supabase ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # 低権限・公開可
# SUPABASE_SECRET_KEY=                    # 高権限・サーバー専用。ブラウザに公開しない

# --- AI Gateway ---
AI_PROVIDER=mock                          # mock | anthropic | openai
# ANTHROPIC_API_KEY=                      # AI_PROVIDER=anthropic のときのみ必要
# OPENAI_API_KEY=                         # AI_PROVIDER=openai のときのみ必要

# --- 決済 ---
PAYMENTS_PROVIDER=mock                    # mock | stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- 通知（メール） ---
MAIL_PROVIDER=mock                        # mock | resend 等
# MAIL_API_KEY=

# --- アプリ設定 ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PREVIEW_BASE_URL=http://localhost:3000/preview
